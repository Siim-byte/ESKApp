DB_NAME = "" #name of database on server
DB_USERNAME = "" #user of database to use data
DB_PASSWORD = "" #password of user of db
DB_HOSTNAME = "" #hostname where db exists at
JWT_SECRET = "" #JWT secret, generate with this command in terminal -> node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
FRONTEND_URL = "" #address of frontend
PORT = 8080 #port to run backend on 
SYNC = true #do you want the database to be synced or näh

#Do not delete this file, just duplicate, rename to ".env" and fill with data, yes you.